{
  "version": 1,
  "minimumMajorVersion": 14,
  "architectures": ["arm64", "x86_64"],
  "pmset": {
    "sleep": "0",
    "womp": "1",
    "autorestart": "1"
  },
  "beszelDaemon": "dev.devfleet.beszel-agent",
  "disk": {
    "warnFreeMiB": 20480,
    "failFreeMiB": 5120,
    "dockerWarnGiB": 64
  },
  "containerWatchdog": {
    "unhealthyChecks": 3,
    "maxRestartsPerHour": 3,
    "intervalSeconds": 60
  },
  "dockerDesktop": {
    "settings": "Library/Group Containers/group.com.docker/settings-store.json",
    "key": "AutoStart"
  },
  "fleetSync": {
    "label": "personal-fleet-sync",
    "intervalMinutes": 30
  },
  "fleetWatch": {
    "label": "dev.devfleet.fleet-watch",
    "intervalMinutes": 15
  },
  "jobLogs": {
    "directory": ".local/share/personal/fleet/manager/logs",
    "maxKiB": 1024,
    "keep": 3
  }
}
