{
  "name": "dev-fleet",
  "version": "0.1.0",
  "private": true,
  "description": "Keeps a set of development machines in sync: one manager and many workers",
  "license": "MIT",
  "repository": "github:crvouga/dev-fleet",
  "type": "module",
  "bin": {
    "devfleet": "./bootstrap/devfleet"
  },
  "scripts": {
    "devfleet": "bun src/cli/cli.ts",
    "tc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "bun test",
    "test:cliproxy": "DEVFLEET_CONFIG=$PWD/examples/fleet.json python3 -B -m unittest discover -s cliproxy/tests -p \"test_*.py\"",
    "lint:cliproxy": "DEVFLEET_CONFIG=$PWD/examples/fleet.json python3 -B cliproxy/scripts/check.py",
    "check": "bun run format && bun run tc && bun run lint && bun test && bun run lint:cliproxy && bun run test:cliproxy"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.5",
    "boxen": "9.0.0",
    "chalk": "6.0.1",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "fuse.js": "7.5.0",
    "ora": "10.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.15.29",
    "eslint": "^9.25.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  }
}
