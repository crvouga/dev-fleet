{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["deps"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The tunnel image of the monitoring hub, by tag and digest. The Beszel image moves with its agents' digests, by hand (docs/declared.md).",
      "managerFilePatterns": ["/^ansible/monitoring/lock\\.json$/"],
      "matchStrings": [
        "\"tunnelImage\": \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The self-hosted tailnet control plane of the tailnet-box scenarios, by tag and digest.",
      "managerFilePatterns": ["/^features/tailnet-box/support/lock\\.json$/"],
      "matchStrings": [
        "\"headscale\": \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Agent CLIs are what every node runs; review each bump on its own.",
      "matchManagers": ["mise"],
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "actions"
    }
  ]
}
